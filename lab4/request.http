}

### 4. Attempt to read the reservation list by USER2 - foreign
# It will return a 200 status code, but the "data" array will not contain the reservation for user USER1. This demonstrates filtering on the backend.
GET http://127.0.0.1:3000/api/reservations
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiVVNFUiIsImlhdCI6MTc5MzMwODI3MCwiZXhwIjoxNzkzMzA5MTcwLCJzdWIiOiIzIn0.e7bt0_ToRKILtVusydEEx-nkuHHycbE0zHkLe7ADznU

### 5. Attempt by USER2 to cancel USER1's reservation
# In accordance with the requirements, it throws a 404 error (without revealing the existence of the resource)
PATCH http://127.0.0.1:3000/api/reservations/7/cancel
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiVVNFUiIsImlhdCI6MTc5MzMwODI3MCwiZXhwIjoxNzkzMzA5MTcwLCJzdWIiOiIzIn0.e7bt0_ToRKILtVusydEEx-nkuHHycbE0zHkLe7ADznU

### 6. Cancellation of reservation USER1 by ADMIN
# The administrator has the right to manipulate any reservation.
PATCH http://127.0.0.1:3000/api/reservations/7/cancel
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiQURNSU4iLCJpYXQiOjE3OTMzMDgxNzAsImV4cCI6MTc5MzMwOTA3MCwic3ViIjoiMSJ9.4gd0LpvaKUR_pP7EObu9oM4Ct81UxHchFzyUz40uN8w
