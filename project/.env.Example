# === ProjectHub - Global Docker Compose Environment Configuration (Example) ===

# PostgreSQL Database Configuration
POSTGRES_USER=PLACEHOLDER_FOR_DB_USER_NAME
POSTGRES_PASSWORD=PLACEHOLDER_FOR_DB_PASSWORD
POSTGRES_DB=PLACEHOLDER_FOR_DB_NAME
POSTGRES_PORT=PLACEHOLDER_FOR_PORT

# ASP.NET Core Web API Backend Configuration
ASPNETCORE_ENVIRONMENT=PLACEHOLDER_FOR_ENVIRONMENT
BACKEND_PORT=PLACEHOLDER_FOR_PORT
JWT_SECRET=PLACEHOLDER_FOR_JWT

# Frontend Web Server & Reverse Proxy Configuration
FRONTEND_PORT=PLACEHOLDER_FOR_PORT
